# CrimeLens AI — Environment Variables
# ======================================
# Copy this file to .env and fill in your values.
# The app works fully in Demo Mode without any key.
#
# How to get a Gemini API key:
#   https://aistudio.google.com/app/apikey
#
# When VITE_GEMINI_KEY is present:
#   → Dashboard shows 🟢 Live Gemini
#   → Complaint Intake uses real Gemini 2.5 Flash extraction
#
# When VITE_GEMINI_KEY is absent or blank:
#   → Dashboard shows 🟡 Demo Mode
#   → Intake uses built-in regex parser (fully functional for demos)

VITE_GEMINI_KEY=
